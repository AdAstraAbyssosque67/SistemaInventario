digraph G {
  graph [rankdir=LR, splines=polyline, nodesep=0.45, ranksep=0.7, fontname="Helvetica", fontsize=16, labelloc=t, pad=0.3];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.8];
  label="Lógica de negocio (SistemaInventario.LogicaNegocio)";
  FabricaServicios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>FabricaServicios</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Categorias : ICategoriaServicio<BR ALIGN="LEFT"/>+ Suplidores : ISuplidorServicio<BR ALIGN="LEFT"/>+ Productos : IProductoServicio<BR ALIGN="LEFT"/>+ Reportes : IReporteServicio<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ServicioBase [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B><I>ServicioBase</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"># Ejecutar&lt;T&gt;(operacion) : Resultado&lt;T&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ICategoriaServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>ICategoriaServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">ObtenerActivas / ObtenerEliminadas / ObtenerPorId<BR ALIGN="LEFT"/>Crear / Actualizar / Eliminar / Restaurar<BR ALIGN="LEFT"/>Filtrar(categorias, texto)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IProductoServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>IProductoServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">ObtenerActivos / ObtenerEliminados / ObtenerPorId<BR ALIGN="LEFT"/>Crear / Actualizar / Eliminar / Restaurar<BR ALIGN="LEFT"/>Filtrar(texto, categoria, suplidor, precios)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ISuplidorServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>ISuplidorServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">ObtenerActivos / ObtenerEliminados / ObtenerPorId<BR ALIGN="LEFT"/>Crear / Actualizar / Eliminar / Restaurar<BR ALIGN="LEFT"/>Filtrar(suplidores, texto)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IReporteServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>IReporteServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">ProductosPorCategoria()<BR ALIGN="LEFT"/>TopSuplidores(cantidad)<BR ALIGN="LEFT"/>PromedioPrecioPorCategoria()<BR ALIGN="LEFT"/>ObtenerResumen()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CategoriaServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>CategoriaServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ProductoServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>ProductoServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SuplidorServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>SuplidorServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ReporteServicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>ReporteServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Validador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><I>&lt;&lt;static&gt;&gt;</I><BR/><B>Validador</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ MaximoFotos : int {const}<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ ValidarCategoria / ValidarSuplidor / ValidarProducto<BR ALIGN="LEFT"/>+ ValidarFoto(nombre, bytes) : string?<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Resultado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><B>Resultado&lt;T&gt;</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Exito : bool<BR ALIGN="LEFT"/>+ Valor : T?<BR ALIGN="LEFT"/>+ Mensaje : string<BR ALIGN="LEFT"/>+ Errores : IReadOnlyDictionary<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Ok(valor) / Falla(mensaje) {static}<BR ALIGN="LEFT"/>+ FallaValidacion(validacion) {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ItemReporte [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><I>&lt;&lt;record&gt;&gt;</I><BR/><B>ItemReporte&lt;T&gt;</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Etiqueta : string<BR ALIGN="LEFT"/>+ Valor : T<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ResumenInventario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER"><I>&lt;&lt;record&gt;&gt;</I><BR/><B>ResumenInventario</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Productos, Categorias, Suplidores : int<BR ALIGN="LEFT"/>+ PrecioPromedio : decimal<BR ALIGN="LEFT"/>+ EnPapelera : int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> <BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ICategoriaRepositorio [label="ICategoriaRepositorio", shape=box, style="rounded,filled", fillcolor="#E6E9EE", fontsize=10, fontname="Helvetica"];
  IProductoRepositorio [label="IProductoRepositorio", shape=box, style="rounded,filled", fillcolor="#E6E9EE", fontsize=10, fontname="Helvetica"];
  ISuplidorRepositorio [label="ISuplidorRepositorio", shape=box, style="rounded,filled", fillcolor="#E6E9EE", fontsize=10, fontname="Helvetica"];
  Logger [label="Logger", shape=box, style="rounded,filled", fillcolor="#E6E9EE", fontsize=10, fontname="Helvetica"];
  AccesoDatosException [label="AccesoDatosException", shape=box, style="rounded,filled", fillcolor="#E6E9EE", fontsize=10, fontname="Helvetica"];
  CategoriaServicio -> ServicioBase [arrowhead=empty];
  CategoriaServicio -> ICategoriaServicio [arrowhead=empty, style=dashed];
  ProductoServicio -> ServicioBase [arrowhead=empty];
  ProductoServicio -> IProductoServicio [arrowhead=empty, style=dashed];
  SuplidorServicio -> ServicioBase [arrowhead=empty];
  SuplidorServicio -> ISuplidorServicio [arrowhead=empty, style=dashed];
  ReporteServicio -> ServicioBase [arrowhead=empty];
  ReporteServicio -> IReporteServicio [arrowhead=empty, style=dashed];
  CategoriaServicio -> ICategoriaRepositorio [arrowhead=open];
  SuplidorServicio -> ISuplidorRepositorio [arrowhead=open];
  ProductoServicio -> IProductoRepositorio [arrowhead=open];
  ReporteServicio -> IProductoRepositorio [arrowhead=open];
  ServicioBase -> Resultado [arrowhead=open, style=dashed];
  ServicioBase -> Logger [arrowhead=open, style=dashed];
  ServicioBase -> AccesoDatosException [arrowhead=open, style=dashed, label="captura"];
  ReporteServicio -> ItemReporte [arrowhead=open, style=dashed];
  ReporteServicio -> ResumenInventario [arrowhead=open, style=dashed];
  CategoriaServicio -> Validador [arrowhead=open, style=dashed];
  ProductoServicio -> Validador [arrowhead=open, style=dashed];
  SuplidorServicio -> Validador [arrowhead=open, style=dashed];
  FabricaServicios -> CategoriaServicio [arrowhead=open];
  FabricaServicios -> ProductoServicio [arrowhead=open];
  FabricaServicios -> SuplidorServicio [arrowhead=open];
  FabricaServicios -> ReporteServicio [arrowhead=open];
}
